# ── Database (PostgreSQL 15+ / Supabase Postgres) ──────────────────────────────
# Owner/superuser connection — used ONLY by `npm run db:migrate` / `db:reset` / `db:seed`.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/salesos
# Runtime role for all tenant traffic. Row-level security is enforced for this role.
# The password you put here is applied to the role by `npm run db:migrate`.
DATABASE_URL=postgres://salesos_app:CHANGE_ME_APP@localhost:5432/salesos
# Privileged runtime role (BYPASSRLS) used only for sign-in, invitations, API-key lookup and platform admin.
DATABASE_SYSTEM_URL=postgres://salesos_system:CHANGE_ME_SYSTEM@localhost:5432/salesos
# "true" for hosted Postgres that requires TLS (Supabase, Neon, RDS)
DB_SSL=false

# ── App ─────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN

# Optional: password used for all seeded demo users (default DigiFalx@2026)
# SEED_PASSWORD=
